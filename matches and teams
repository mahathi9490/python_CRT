a=int(input("Enter number of teams: "))
teams=[]
print("Enter all team names: ")
for i in range(a):
    t=input("Enter the team name:")
    teams.append(t)
m=int(input("Enter number of meet between teams: "))
matches=[]
for i in range(0,a-1):
    for j in   range(i+1,a):
        for k in range(m):
            matches.append([teams[i],teams[j]])
random.shuffle(matches)
pos=1
for i in matches:
    print("MATCH {} : {} vs {}".format(pos,i[0],i[1]))
    pos=pos+1
